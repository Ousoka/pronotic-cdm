generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum RoundType {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  name      String?
  email     String   @unique
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]

  @@index([lastName, firstName])
  @@index([email])
}

model WorldCupMatch {
  id          String      @id @default(cuid())
  fifaId      String?     @unique
  round       RoundType   @default(GROUP)
  groupName   String?
  matchNumber Int?        @unique
  homeTeam    String
  awayTeam    String
  stadium     String?
  city        String?
  kickoffAt   DateTime
  lockedAt    DateTime?
  status      MatchStatus @default(SCHEDULED)
  homeScore   Int?
  awayScore   Int?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  predictions Prediction[]

  @@index([kickoffAt])
  @@index([status])
  @@index([round])
}

model Prediction {
  id               String   @id @default(cuid())
  userId           String
  matchId          String
  predictedHome    Int
  predictedAway    Int
  scorePoints      Int      @default(0)
  outcomePoints    Int      @default(0)
  totalPoints      Int      @default(0)
  isCorrected      Boolean  @default(false)
  correctedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  match WorldCupMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Database-level protection: one prediction per email/user and per match.
  // Since User.email is unique, this enforces one pronostic per email per match.
  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
  @@index([totalPoints])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}
