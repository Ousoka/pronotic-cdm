# Render PostgreSQL External Database URL for local development.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required for admin area only. Public users do NOT sign in.
ADMIN_PASSWORD="change-this-admin-password"

# Used to sign the lightweight admin cookie and hash IPs in audit logs.
APP_SECRET="change-this-long-random-secret"

# Only emails ending with this domain can submit pronostics.
ALLOWED_EMAIL_DOMAIN="yas.sn"

# Optional: protects /api/cron/score
CRON_SECRET="change-this-cron-secret"
